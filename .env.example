# Copy to .env and fill in. Restart `npm run dev` after changing.

# OAuth client IDs (created in each provider's developer console)
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_CLIENT_ID=
VITE_TWITTER_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# Must exactly match the redirect URI registered with each provider.
# Leave empty to use the current page URL (e.g. http://localhost:5173/).
VITE_REDIRECT_URI=

# Your backend. Leave empty to run in demo mode (no real login / sign-up calls).
# Expected endpoints: POST /auth/login, POST /auth/signup, POST /auth/oauth/twitter
VITE_API_BASE_URL=
